# Đổi tên file này thành `.env` và điền các giá trị bên dưới
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
GUILD_ID=your-test-guild-id

# PostgreSQL: run SETUP_POSTGRES.bat on Windows, or configure a dedicated database.
DATABASE_URL=postgresql://discord_bot:change-me@127.0.0.1:5432/discord_bot

# Nhieu server: dien ID cach nhau bang dau phay (thay cho GUILD_ID)
# GUILD_IDS=123456789012345678,234567890123456789

# Quan ly server dang tat trong config/features.json.
# Cac tinh nang tuy chon khong ghi de config/features.json.
ENABLE_ROLE_COMMAND=false
# Bat Server Members Intent trong Developer Portal truoc khi dat true.
ENABLE_MEMBER_GREETINGS=false

# Tuy chon: ID role DJ cua cac server, cach nhau bang dau phay. Neu server
# khong co role duoc chi dinh, bot dung role ten DJ.
# DJ_ROLE_IDS=123456789012345678,234567890123456789

# Tuy chon: ID tai khoan Discord duoc quan ly xu qua tin nhan rieng.
TAIXIU_OWNER_ID=

# Tuy chon: log thong ke hieu nang tong hop moi 60 giay (khong chua ID/URL/truy van).
HOM_PERF_METRICS=false

PORT=3001
# Sau Nginx tren cung VPS: chi nhan ket noi noi bo. Bo trong de giu che do mac dinh.
# HTTP_HOST=127.0.0.1

# Trang quan tri chay cung bot tai /admin/. Chay scripts/admin-password.js de
# tao mat khau bam va bat trang. Khong dung DISCORD_TOKEN lam mat khau.
ADMIN_ENABLED=false
ADMIN_ORIGIN=http://127.0.0.1:3001
ADMIN_PASSWORD_HASH=
# HTTPS: true. HTTP chi cho localhost/SSH tunnel: false.
ADMIN_COOKIE_SECURE=false

# Web nguoi choi dung chung xu va kho Discord. Lay ma dang nhap bang /web.
# Chua co ten mien: dung scripts/open-play.ps1 qua SSH. Cong khai can HTTPS.
PLAYER_ENABLED=false
PLAYER_ORIGIN=http://127.0.0.1:3001
