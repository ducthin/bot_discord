{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "Bot Discord phát nhạc với các tính năng nâng cao",
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "build:play": "node scripts/build-play.mjs",
    "db:init": "node scripts/database.js init",
    "db:check": "node scripts/database.js check",
    "db:reset": "node scripts/database.js reset",
    "dev": "nodemon --config .nodemonrc index.js",
