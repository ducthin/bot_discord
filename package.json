    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.2.0",
    "genius-lyrics": "^4.4.7",
    "libsodium-wrappers": "^0.7.11",
    "opusscript": "^0.0.8",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yt-dlp-exec": "^1.0.2",
    "yt-search": "^2.10.4"
  },
  "devDependencies": {
